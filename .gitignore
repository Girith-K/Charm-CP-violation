# --- data: never commit the ntuples (tens of GB; provenance lives in text) ---
data/
*.root

# --- python ---
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv*/
*.egg-info/
build/
dist/
.pytest_cache/
.ruff_cache/

# --- os / editor ---
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- scratch ---
*.lock.yml.bak
*.tmp

# Keep the empty data dir tracked
!data/.gitkeep

# NOT ignored, deliberately:
#   plots/*.png        -> REPORT.md embeds these; without them the paper
#                         renders with broken images on GitHub (~2 MB total)
#   results/*.json     -> machine-readable outputs of every pipeline stage;
#                         small, and they make the numbers in the report
#                         checkable without rerunning 8 GB of ntuples
#   results/*.log|txt  -> the run_all transcript, ~20 KB, useful provenance
#   report/provenance/ -> the request YAMLs: what was asked of CERN, exactly
#   report/*.docx      -> the paper deliverable (hand-edited, not generated)
